#!/bin/bash
# Sartoria TUI installer. Whole-disk wipe. Interactive installs may encrypt
# the root with LUKS2. Unattended lab installs stay ext4. Not Calamares.
set -euo pipefail

LOG=/var/log/sartoria-installer.log
mkdir -p "$(dirname "$LOG")"

AUTO=0
[[ "${1:-}" == "--auto" ]] && AUTO=1
grep -qw sartoria.auto /proc/cmdline 2>/dev/null && AUTO=1
[[ -f /sartoria-auto ]] && AUTO=1

# Interactive UI on the real console. Never write installer logs to tty1:
# they corrupt dialog and get captured by $(ask).
UI_TTY=/dev/tty1
[[ -e /dev/tty ]] && UI_TTY=/dev/tty

log() {
  printf 'sartoria-installer: %s\n' "$*" >>"$LOG"
  if [[ -w /dev/ttyS0 ]]; then
    printf 'sartoria-installer: %s\n' "$*" >/dev/ttyS0 2>/dev/null || true
  fi
}
show_err() {
  log "ERROR: $*"
  printf '\n*** Sartoria installer ***\n%s\n\n(This is still the LIVE ISO.)\n' "$*" >/dev/tty1
  printf '%s\n' "$*" >/dev/ttyS0 2>/dev/null || true
  sleep 8
}

die() {
  show_err "$*"
  exit 1
}

on_err() {
  local rc=$?
  show_err "Command failed (line ${BASH_LINENO[0]}, rc ${rc}): ${BASH_COMMAND}"
  exit "$rc"
}
trap on_err ERR

drain_tty() {
  local _c
  while IFS= read -r -t 0.1 -n 1 _c; do :; done <"$UI_TTY" 2>/dev/null || true
}

# dialog: UI on stdout, value on stderr. Send UI to the console, value to a file.
ask() {
  local title="$1" text="$2" default="${3:-}" tmp rc val
  if [[ "$AUTO" -eq 1 ]]; then
    printf '%s\n' "$default"
    return 0
  fi
  tmp="$(mktemp)"
  drain_tty
  stty sane <"$UI_TTY" 2>/dev/null || true
  set +e
  dialog --title "$title" --inputbox "$text" 14 70 "$default" >"$UI_TTY" 2>"$tmp"
  rc=$?
  set -e
  val="$(tr -d '\r' <"$tmp" | tail -n 1)"
  rm -f "$tmp"
  if [[ "$rc" -ne 0 || -z "$val" ]]; then
    printf '%s\n' "$default"
  else
    printf '%s\n' "$val"
  fi
}

ask_password() {
  local title="$1" text="$2" tmp rc val
  if [[ "$AUTO" -eq 1 ]]; then
    printf '%s\n' "sartoria"
    return 0
  fi
  tmp="$(mktemp)"
  drain_tty
  stty sane <"$UI_TTY" 2>/dev/null || true
  set +e
  # No --insecure: echo must stay off. Result on stderr, UI on $UI_TTY.
  dialog --title "$title" --passwordbox "$text" 10 60 >"$UI_TTY" 2>"$tmp"
  rc=$?
  set -e
  val="$(tr -d '\r' <"$tmp" | tail -n 1)"
  rm -f "$tmp"
  [[ "$rc" -eq 0 ]] || die "password entry cancelled"
  printf '%s\n' "$val"
}

ask_yesno() {
  local title="$1" text="$2" rc
  if [[ "$AUTO" -eq 1 ]]; then
    return 1
  fi
  drain_tty
  stty sane <"$UI_TTY" 2>/dev/null || true
  set +e
  dialog --title "$title" --defaultno --yesno "$text" 12 72 >"$UI_TTY"
  rc=$?
  set -e
  [[ "$rc" -eq 0 ]]
}

ask_luks_pass() {
  local p1 p2
  while true; do
    p1="$(ask_password "Disk encryption" "LUKS passphrase for the disk (8 or more characters). This is not the login password.")"
    p2="$(ask_password "Disk encryption" "LUKS passphrase again")"
    if [[ "$p1" != "$p2" ]]; then
      show_err "LUKS passphrases do not match."
      continue
    fi
    if [[ ${#p1} -lt 8 ]]; then
      show_err "LUKS passphrase must be at least 8 characters."
      continue
    fi
    printf '%s\n' "$p1"
    return 0
  done
}

confirm_wipe() {
  local disk="$1" extra="${2:-}" typed
  if [[ "$AUTO" -eq 1 ]]; then
    return 0
  fi
  while true; do
    typed="$(ask "Wipe ${disk}" "${extra}Destroys all data on ${disk}. Type YES to continue, or ABORT to stop." "")"
    typed="$(printf '%s' "$typed" | tr -d '[:space:]')"
    case "$typed" in
      YES) return 0 ;;
      ABORT|abort|Quit|QUIT) die "Wipe cancelled." ;;
      *) show_err "Type YES (capitals) to wipe, or ABORT to stop. You typed: '${typed}'" ;;
    esac
  done
}

live_medium() {
  local src
  for p in /run/live/medium /lib/live/mount/medium /run/live/fromiso; do
    if [[ -d "$p" ]]; then
      src="$(findmnt -n -o SOURCE --target "$p" 2>/dev/null || true)"
      printf '%s\n' "$src"
      return
    fi
  done
}

squashfs_path() {
  local p
  for p in \
    /run/live/medium/live/filesystem.squashfs \
    /lib/live/mount/medium/live/filesystem.squashfs \
    /live/filesystem.squashfs; do
    [[ -f "$p" ]] && { printf '%s\n' "$p"; return; }
  done
  die "cannot find filesystem.squashfs on the live medium"
}

live_disk_name() {
  local live_src live_disk
  live_src="$(live_medium || true)"
  live_disk=""
  if [[ -n "$live_src" ]]; then
    live_disk="$(lsblk -no PKNAME "$live_src" 2>/dev/null | head -n1 || true)"
    if [[ -z "$live_disk" && "$live_src" == /dev/* ]]; then
      live_disk="$(basename "$live_src" | sed 's/[0-9][0-9]*$//')"
    fi
  fi
  printf '%s\n' "$live_disk"
}

disk_os_hint() {
  local name="$1" info
  info="$(lsblk -n -o FSTYPE,PARTTYPENAME "/dev/$name" 2>/dev/null | tr '\n' ' ')"
  if printf '%s' "$info" | grep -qiE 'ntfs|bitlocker|microsoft|hpfs'; then
    printf '%s\n' "NTFS/Windows — leave this if it is the Windows drive"
  elif printf '%s' "$info" | grep -qiE 'ext4|btrfs|xfs'; then
    printf '%s\n' "Linux filesystem"
  else
    printf '%s\n' "no Windows/Linux labels seen"
  fi
}

# Prints: name<TAB>size_bytes<TAB>label  for each installable disk.
list_candidate_disks() {
  local live_disk name type size tran model human hint
  live_disk="$(live_disk_name)"
  while IFS= read -r line; do
    eval "$line"
    [[ "${TYPE:-}" == disk ]] || continue
    name="${NAME:-}"
    size="${SIZE:-0}"
    tran="${TRAN:-}"
    model="${MODEL:-}"
    [[ -n "$name" ]] || continue
    [[ "$name" == fd* || "$name" == sr* || "$name" == loop* || "$name" == ram* || "$name" == zram* || "$name" == md* ]] && continue
    [[ "$tran" == "floppy" ]] && continue
    [[ -n "$live_disk" && "$name" == "$live_disk" ]] && continue
    [[ "$size" =~ ^[0-9]+$ ]] || continue
    [[ "$size" -ge 1073741824 ]] || continue
    if command -v numfmt >/dev/null 2>&1; then
      human="$(numfmt --to=iec --suffix=B "$size")"
    else
      human="$((size / 1073741824))G"
    fi
    hint="$(disk_os_hint "$name")"
    model="${model:-unknown}"
    printf '%s\t%s\t%s %s — %s\n' "$name" "$size" "$human" "$model" "$hint"
  done < <(lsblk -dn -b -P -o NAME,TYPE,SIZE,TRAN,MODEL)
}

# Unattended: largest eligible disk.
target_disk() {
  local name size label best="" best_size=0
  while IFS=$'\t' read -r name size label; do
    [[ "$size" -gt "$best_size" ]] || continue
    best="$name"
    best_size="$size"
  done < <(list_candidate_disks)
  [[ -n "$best" ]] || return 1
  echo "/dev/$best"
}

pick_disk() {
  local name size label tmp rc val
  if [[ "$AUTO" -eq 1 ]]; then
    target_disk
    return
  fi
  tmp="$(mktemp)"
  local -a menu_args=()
  while IFS=$'\t' read -r name size label; do
    menu_args+=("$name" "$label")
  done < <(list_candidate_disks)
  if [[ ${#menu_args[@]} -eq 0 ]]; then
    rm -f "$tmp"
    return 1
  fi
  drain_tty
  stty sane <"$UI_TTY" 2>/dev/null || true
  set +e
  dialog --title "Install disk" --menu \
    "Choose the disk to WIPE. Other disks are left alone. Do not pick the Windows drive." \
    20 74 8 "${menu_args[@]}" >"$UI_TTY" 2>"$tmp"
  rc=$?
  set -e
  val="$(tr -d '\r' <"$tmp" | tail -n 1)"
  rm -f "$tmp"
  [[ "$rc" -eq 0 && -n "$val" ]] || die "Disk selection cancelled."
  echo "/dev/$val"
}

nvidia_note() {
  if lspci 2>/dev/null | grep -qi nvidia; then
    log "NVIDIA GPU detected; ISO keeps iGPU/modesetting. After reboot install sartoria-nvidia (Prime offload)."
  else
    log "No NVIDIA GPU (skip proprietary path)"
  fi
}

log "start auto=$AUTO"

KEYMAP="$(ask "Keyboard" "Keyboard layout (example: us, gb, de)" "us")"
[[ -n "$KEYMAP" ]] || KEYMAP=us
loadkeys "$KEYMAP" </dev/null >/dev/null 2>&1 || true

HOSTNAME="$(ask "Hostname" "Hostname for this machine" "sartoria")"
[[ -n "$HOSTNAME" ]] || HOSTNAME=sartoria

USERNAME="$(ask "User" "Username (sudo, no root login)" "sartoria")"
[[ -n "$USERNAME" ]] || USERNAME=sartoria
echo "$USERNAME" | grep -Eq '^[a-z_][a-z0-9_-]*$' || die "invalid username"

PASS1="$(ask_password "Password" "Password for ${USERNAME}")"
PASS2="$(ask_password "Password" "Password again")"
[[ "$PASS1" == "$PASS2" ]] || die "passwords do not match"
[[ -n "$PASS1" ]] || die "empty password"

DISK="$(pick_disk || true)"
[[ -b "$DISK" ]] || die "No install disk found. Attach a virtual hard disk (>= 1G). Floppy (/dev/fd0) and CD-ROM are ignored."
log "target disk: $DISK"

LUKS=0
LUKS_PASS=""
if ask_yesno "Encrypt disk" "Encrypt the root filesystem with LUKS2? The EFI system partition and /boot stay unencrypted so GRUB can load the kernel. The unattended lab install does not encrypt. Choose No to keep the v0.1 ext4 layout."; then
  LUKS=1
  LUKS_PASS="$(ask_luks_pass)"
  confirm_wipe "$DISK" "Root will be LUKS2. "
else
  confirm_wipe "$DISK"
fi
log "encrypt=$LUKS"
if [[ "$AUTO" -eq 0 ]]; then
  set +e
  dialog --title "Sartoria" --infobox "Installing to ${DISK}. This takes a few minutes." 5 50 >"$UI_TTY"
  set -e
fi

nvidia_note

command -v sgdisk >/dev/null || die "sgdisk missing"
command -v unsquashfs >/dev/null || die "unsquashfs missing"

SQUASH="$(squashfs_path)"
log "payload: $SQUASH"

if [[ -b /dev/mapper/sartoria_crypt ]]; then
  cryptsetup close sartoria_crypt || true
fi
wipefs -a "$DISK" || true
sgdisk --zap-all "$DISK" || die "sgdisk zap failed on $DISK"
# Hybrid GPT: BIOS boot (SeaBIOS/QEMU default) + ESP (UEFI) + root.
# LUKS adds an unencrypted /boot so GRUB does not need cryptodisk.
# The passphrase is asked once, by the initramfs.
if [[ "$LUKS" -eq 1 ]]; then
  command -v cryptsetup >/dev/null || die "cryptsetup missing on this ISO"
  sgdisk -n 1:0:+1M -t 1:ef02 -c 1:bios_grub \
         -n 2:0:+512M -t 2:ef00 -c 2:EFI \
         -n 3:0:+1G -t 3:8300 -c 3:boot \
         -n 4:0:0 -t 4:8309 -c 4:cryptroot \
         "$DISK" || die "sgdisk partition failed on $DISK"
else
  sgdisk -n 1:0:+1M -t 1:ef02 -c 1:bios_grub \
         -n 2:0:+512M -t 2:ef00 -c 2:EFI \
         -n 3:0:0 -t 3:8300 -c 3:root \
         "$DISK" || die "sgdisk partition failed on $DISK"
fi
partprobe "$DISK" || true
sleep 1

part_n() {
  local n="$1"
  if [[ -b "${DISK}${n}" ]]; then echo "${DISK}${n}"
  elif [[ -b "${DISK}p${n}" ]]; then echo "${DISK}p${n}"
  else die "partition $n not found on $DISK"
  fi
}
P_BIOS="$(part_n 1)"
P_EFI="$(part_n 2)"
if [[ "$LUKS" -eq 1 ]]; then
  P_BOOT="$(part_n 3)"
  P_LUKS="$(part_n 4)"
else
  P_ROOT="$(part_n 3)"
fi

mkfs.fat -F32 -n EFI "$P_EFI" || die "mkfs.fat failed on $P_EFI"
if [[ "$LUKS" -eq 1 ]]; then
  mkfs.ext4 -F -L boot "$P_BOOT" || die "mkfs.ext4 failed on $P_BOOT"
  keyfile="$(mktemp)"
  chmod 600 "$keyfile"
  printf '%s' "$LUKS_PASS" >"$keyfile"
  unset LUKS_PASS
  cryptsetup luksFormat --type luks2 --batch-mode --key-file "$keyfile" "$P_LUKS" \
    || die "luksFormat failed on $P_LUKS"
  cryptsetup open --key-file "$keyfile" "$P_LUKS" sartoria_crypt \
    || die "cryptsetup open failed on $P_LUKS"
  shred -u "$keyfile" 2>/dev/null || rm -f "$keyfile"
  P_ROOT=/dev/mapper/sartoria_crypt
fi
mkfs.ext4 -F -L sartoria "$P_ROOT" || die "mkfs.ext4 failed on $P_ROOT"

TARGET=/mnt/sartoria-target
mkdir -p "$TARGET"
mount "$P_ROOT" "$TARGET" || die "mount $P_ROOT failed"
if [[ "$LUKS" -eq 1 ]]; then
  mkdir -p "$TARGET/boot"
  mount "$P_BOOT" "$TARGET/boot" || die "mount $P_BOOT failed"
fi

log "copying payload (this takes a few minutes)"
unsquashfs -f -d "$TARGET" "$SQUASH" || die "unsquashfs failed"
mkdir -p "$TARGET/boot/efi"
mount "$P_EFI" "$TARGET/boot/efi" || die "mount EFI $P_EFI failed"

rm -f "$TARGET/.sartoria-live" "$TARGET/sartoria-auto"
if [[ -f /usr/share/sartoria/inittab.disk ]]; then
  cp /usr/share/sartoria/inittab.disk "$TARGET/etc/inittab"
fi
rm -f "$TARGET/usr/lib/sartoria/installer-tty"

UUID_ROOT="$(blkid -s UUID -o value "$P_ROOT")"
UUID_EFI="$(blkid -s UUID -o value "$P_EFI")"
{
  printf 'UUID=%s / ext4 errors=remount-ro 0 1\n' "$UUID_ROOT"
  if [[ "$LUKS" -eq 1 ]]; then
    UUID_BOOT="$(blkid -s UUID -o value "$P_BOOT")"
    UUID_LUKS="$(blkid -s UUID -o value "$P_LUKS")"
    printf 'UUID=%s /boot ext4 defaults 0 2\n' "$UUID_BOOT"
    printf 'sartoria_crypt UUID=%s none luks,discard\n' "$UUID_LUKS" > "$TARGET/etc/crypttab"
  else
    rm -f "$TARGET/etc/crypttab"
  fi
  printf 'UUID=%s /boot/efi vfat umask=0077 0 1\n' "$UUID_EFI"
} > "$TARGET/etc/fstab"

echo "$HOSTNAME" > "$TARGET/etc/hostname"
cat > "$TARGET/etc/hosts" <<EOF
127.0.0.1 localhost
127.0.1.1 $HOSTNAME
::1 localhost ip6-localhost ip6-loopback
EOF

cat > "$TARGET/etc/default/keyboard" <<EOF
XKBMODEL="pc105"
XKBLAYOUT="${KEYMAP}"
XKBVARIANT=""
XKBOPTIONS=""
BACKSPACE="guess"
EOF

for d in proc sys dev dev/pts run; do
  mkdir -p "$TARGET/$d"
  mount --bind "/$d" "$TARGET/$d"
done
if [[ -d /sys/firmware/efi/efivars ]]; then
  mkdir -p "$TARGET/sys/firmware/efi/efivars"
  mount --bind /sys/firmware/efi/efivars "$TARGET/sys/firmware/efi/efivars" || true
fi

chroot "$TARGET" /usr/sbin/locale-gen >/dev/null 2>&1 || true
chroot "$TARGET" /usr/sbin/update-initramfs -u || true

if chroot "$TARGET" id "$USERNAME" >/dev/null 2>&1; then
  chroot "$TARGET" userdel -r "$USERNAME" >/dev/null 2>&1 || true
fi
chroot "$TARGET" useradd -m -s /bin/bash -G sudo,audio,video,render,input,plugdev "$USERNAME"
echo "${USERNAME}:${PASS1}" | chroot "$TARGET" chpasswd
chroot "$TARGET" passwd -l root >/dev/null
if [[ -x "$TARGET/usr/lib/sartoria/seed-user-config" ]]; then
  chroot "$TARGET" /usr/lib/sartoria/seed-user-config --system || true
fi

chroot "$TARGET" DEBIAN_FRONTEND=noninteractive apt-get -y purge live-boot live-boot-initramfs-tools 2>/dev/null || true
chroot "$TARGET" /usr/sbin/update-initramfs -u || true

chroot "$TARGET" mkdir -p /boot/efi/EFI/BOOT
# BIOS GRUB uses the 1M bios_grub slice (needed for SeaBIOS/QEMU without UEFI).
chroot "$TARGET" grub-install --target=i386-pc --recheck "$DISK" || die "BIOS grub-install failed"
if [[ -d /sys/firmware/efi ]]; then
  chroot "$TARGET" grub-install --target=x86_64-efi --efi-directory=/boot/efi \
    --bootloader-id=Sartoria --recheck --no-nvram --removable || die "EFI grub-install failed"
fi
chroot "$TARGET" update-grub || die "update-grub failed"

chroot "$TARGET" rm -f /etc/ssh/ssh_host_* 2>/dev/null || true
chroot "$TARGET" dpkg-reconfigure -f noninteractive openssh-server >/dev/null 2>&1 || true
rm -f "$TARGET/etc/machine-id" "$TARGET/var/lib/dbus/machine-id"
chroot "$TARGET" /bin/systemd-machine-id-setup >/dev/null 2>&1 || \
  chroot "$TARGET" sh -c 'dbus-uuidgen --ensure=/etc/machine-id' || \
  printf '%s\n' "$(head -c 16 /dev/urandom | xxd -p)" > "$TARGET/etc/machine-id"

sync
for d in sys/firmware/efi/efivars proc sys dev/pts dev run boot/efi boot; do
  umount -l "$TARGET/$d" 2>/dev/null || true
done
umount -l "$TARGET" || true
if [[ "$LUKS" -eq 1 ]]; then
  cryptsetup close sartoria_crypt || true
fi

log "Installation complete"
printf 'SARTORIA_INSTALL_OK\n'
if [[ "$AUTO" -eq 1 ]]; then
  sleep 2
  poweroff -f
fi
if [[ "$AUTO" -eq 0 ]]; then
  dialog --title "Sartoria" --msgbox "Install finished. Remove the USB/ISO and reboot." 8 50 || true
fi
exit 0
