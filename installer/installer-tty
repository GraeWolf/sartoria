#!/bin/sh
# tty1 entry on the live ISO. Interactive installer, or auto if requested.
# inittab does not always attach a controlling tty; bind to tty1 explicitly.
sleep 2
chvt 1 2>/dev/null || true
export TERM="${TERM:-linux}"

banner() {
  msg="Sartoria: TUI installer is on the VGA/display window (tty1). sshd listening is not the installer."
  [ -w /dev/ttyS0 ] && printf '\n%s\n' "$msg" >/dev/ttyS0
  [ -w /dev/console ] && printf '\n%s\n' "$msg" >/dev/console
}

banner

if grep -qw sartoria.auto /proc/cmdline 2>/dev/null || [ -f /sartoria-auto ]; then
  if [ -w /dev/ttyS0 ]; then
    /usr/sbin/sartoria-installer --auto </dev/null >/dev/ttyS0 2>&1
  else
    /usr/sbin/sartoria-installer --auto
  fi
  rc=$?
  [ "$rc" -eq 0 ] && exit 0
  exec /sbin/getty 38400 tty1
fi

# Interactive: dialog must own tty1.
exec setsid sh -c 'exec /usr/sbin/sartoria-installer <>/dev/tty1 >&0 2>&1'
