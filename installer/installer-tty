#!/bin/sh
# tty1 entry on the live ISO. init already attached this process to tty1.
# Do not setsid: that drops the controlling tty and dialog mishandles Enter/echo.
sleep 2
chvt 1 2>/dev/null || true
export TERM="${TERM:-linux}"
stty sane </dev/tty1 2>/dev/null || true
stty sane 2>/dev/null || true

if [ -w /dev/ttyS0 ]; then
  printf '\nSartoria TUI is on the graphical console (tty1), not SSH or serial.\n' >/dev/ttyS0
fi

if grep -qw sartoria.auto /proc/cmdline 2>/dev/null || [ -f /sartoria-auto ]; then
  if [ -w /dev/ttyS0 ]; then
    /usr/sbin/sartoria-installer --auto </dev/null >/dev/ttyS0 2>&1
  else
    /usr/sbin/sartoria-installer --auto
  fi
  # Fall through to getty so inittab respawn does not restart the installer.
  exec /sbin/getty 38400 tty1
fi

# Run the TUI on the fds init gave us (tty1). Always end at getty.
/usr/sbin/sartoria-installer <>/dev/tty1 >&0 2>&1 || true
printf '\nInstaller stopped. This login is the LIVE ISO (hostname sartoria-live),\nnot an installed system. Reboot the ISO to try again.\n' >/dev/tty1
exec /sbin/getty 38400 tty1
