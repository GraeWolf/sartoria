#!/bin/sh
# elogind sleep hook for this G15.
# Do not write /proc/driver/nvidia/suspend (hung: fans, no s2idle).
# After s2idle the ITE keyboard (0b05:19b6) often stays enumerated and
# stops sending reports. Always re-enumerate it. That resets
# asus::kbd_backlight to 0. The brightness keys do not update that
# file (hid-asus only stores a level when sysfs is written), so a
# pre-suspend read of 0 must not forget the last lit level.
# Do not reset i8042. "echo reset" reconnects atkbd, which sends
# ATKBD_CMD_RESET_DIS (0xF5). This EC logs "Failed to deactivate
# keyboard on isa0060/serio0" and then stops responding until a hard
# power-off. i8042.dumbkbd=1 on the cmdline stops the kernel from
# sending that command on its own resume path.
# $1 = pre|post  $2 = suspend|hibernate|...
KBD_VENDOR=0b05
KBD_PRODUCT=19b6
XHCI=0000:07:00.3
LED=/sys/class/leds/asus::kbd_backlight/brightness
SAVE=/run/sartoria-kbd-backlight
PERSIST=/var/lib/sartoria/kbd-backlight

log() {
  logger -t sartoria-nvidia -- "$@" 2>/dev/null || true
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo '?')" "$*" \
    >> /var/log/sartoria-sleep.log 2>/dev/null || true
}

kbd_sysfs() {
  for d in /sys/bus/usb/devices/*; do
    [ -f "$d/idVendor" ] && [ -f "$d/idProduct" ] || continue
    [ "$(cat "$d/idVendor")" = "$KBD_VENDOR" ] || continue
    [ "$(cat "$d/idProduct")" = "$KBD_PRODUCT" ] || continue
    printf '%s\n' "$d"
    return 0
  done
  return 1
}

valid_level() {
  case "$1" in
    0|1|2|3) return 0 ;;
  esac
  return 1
}

# hid-asus reports 0 after probe and after the brightness keys, which
# never write this sysfs file. Only 1–3 from sysfs update the saved
# level. A stored 0 is how the lights stay off across suspend.
save_backlight() {
  mkdir -p /var/lib/sartoria 2>/dev/null || true
  val=3
  if [ -s "$PERSIST" ]; then
    val=$(cat "$PERSIST")
  fi
  valid_level "$val" || val=3
  if [ -r "$LED" ]; then
    cur=$(cat "$LED")
    case "$cur" in
      1|2|3) val=$cur ;;
    esac
  fi
  printf '%s\n' "$val" > "$PERSIST" 2>/dev/null || true
  printf '%s\n' "$val" > "$SAVE" 2>/dev/null || true
  chmod 644 "$PERSIST" "$SAVE" 2>/dev/null || true
  log "kbd backlight save $val"
}

apply_backlight() {
  echo "$1" > "$LED" 2>/dev/null || true
}

restore_backlight() {
  n=0
  while [ ! -w "$LED" ] && [ "$n" -lt 8 ]; do
    sleep 1
    n=$((n + 1))
  done
  val=3
  if [ -s "$PERSIST" ]; then
    val=$(cat "$PERSIST")
  fi
  if [ -s "$SAVE" ]; then
    val=$(cat "$SAVE")
  fi
  valid_level "$val" || val=3
  if [ ! -w "$LED" ]; then
    log "kbd backlight node missing; left unrestored"
    return 0
  fi
  # Probe leaves the software level at 0. Wait until the new HID
  # device accepts the report, then write twice. The second write
  # still runs brightness_set because we step away and back.
  sleep 1
  if [ "$val" != 0 ]; then
    apply_backlight 0
    sleep 1
  fi
  apply_backlight "$val"
  log "kbd backlight -> $val"
}

reset_xhci() {
  [ -e "/sys/bus/pci/drivers/xhci_hcd/$XHCI" ] || return 0
  log "ASUS keyboard missing; reset xhci $XHCI"
  echo "$XHCI" > /sys/bus/pci/drivers/xhci_hcd/unbind 2>/dev/null || true
  sleep 1
  echo "$XHCI" > /sys/bus/pci/drivers/xhci_hcd/bind 2>/dev/null || true
}

# Re-authorize even when the device is still present. Presence is not
# the same as working keys.
reenumerate_kbd() {
  dev=$(kbd_sysfs) || dev=
  if [ -n "$dev" ] && [ -w "$dev/authorized" ]; then
    log "re-enumerate ASUS keyboard $(basename "$dev")"
    echo 0 > "$dev/authorized" 2>/dev/null || true
    sleep 1
    if [ ! -w "$dev/authorized" ]; then
      dev=$(kbd_sysfs) || dev=
    fi
    if [ -n "$dev" ] && [ -w "$dev/authorized" ]; then
      echo 1 > "$dev/authorized" 2>/dev/null || true
      return 0
    fi
  fi
  reset_xhci
}

kick_i2c_hid_if_missing() {
  if grep -q ASUE120D /sys/class/input/*/name 2>/dev/null; then
    return 0
  fi
  drv=/sys/bus/i2c/drivers/i2c_hid_acpi
  [ -d "$drv" ] || return 0
  log "i2c touchpad missing; rebind i2c_hid_acpi"
  for link in "$drv"/*; do
    [ -e "$link" ] || continue
    name=$(basename "$link")
    case "$name" in
      bind|unbind|uevent|module) continue ;;
    esac
    echo "$name" > "$drv/unbind" 2>/dev/null || true
    echo "$name" > "$drv/bind" 2>/dev/null || true
  done
}

case "$1" in
  pre)
    save_backlight
    ;;
  post)
    sleep 1
    reenumerate_kbd
    kick_i2c_hid_if_missing
    restore_backlight
    chmod 644 /var/log/sartoria-sleep.log 2>/dev/null || true
    ;;
esac
exit 0
