[global]
    font = JetBrainsMono Nerd Font 11
    frame_width = 2
    frame_color = "#7aa2f7"
    separator_color = frame
    origin = top-right
    offset = 12x40
    width = 320
    padding = 8
    horizontal_padding = 8

[urgency_low]
    background = "#1a1b26"
    foreground = "#c0caf5"

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"

[urgency_critical]
    background = "#1a1b26"
    foreground = "#f7768e"
    frame_color = "#f7768e"
