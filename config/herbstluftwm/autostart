#!/usr/bin/env bash
# Sartoria herbstluftwm defaults. Super is modkey. Manual tiling.
hc() { herbstclient "$@"; }

hc emit_hook reload
hc keyunbind --all
hc mouseunbind --all
hc unrule -F

# Super is the product modkey. Alt is bound too so a host that also uses
# Super (Omarchy/Hyprland) does not steal every shortcut from a VM.
TERMINAL="${TERMINAL:-alacritty}"
bind() {
  local spec="$1"
  shift
  hc keybind "Mod4-$spec" "$@"
  hc keybind "Mod1-$spec" "$@"
}

hc set default_frame_layout horizontal
hc set auto_detect_monitors on
hc set focus_follows_mouse off
hc set frame_border_width 2
hc set window_border_width 2
hc set frame_gap 6
hc set window_gap 4
hc set frame_padding 0
hc set smart_window_surroundings off
hc set smart_frame_surroundings on

# Tokyo Night-class (cool-neutral dark)
hc set frame_border_active_color '#7aa2f7'
hc set frame_border_normal_color '#1a1b26'
hc set window_border_active_color '#7aa2f7'
hc set window_border_normal_color '#414868'
hc set frame_bg_active_color '#1a1b26'
hc set frame_bg_normal_color '#16161e'
hc set frame_bg_transparent on
hc set frame_transparent_width 0

command -v xsetroot >/dev/null && xsetroot -solid '#1a1b26'

bind Shift-e quit
bind Shift-q quit
bind Shift-r reload
bind q close
bind Return spawn "$TERMINAL"
bind space spawn rofi -show drun
if command -v sartoria-browser >/dev/null 2>&1; then
  bind b spawn sartoria-browser
fi
if command -v sartoria-files >/dev/null 2>&1; then
  bind e spawn sartoria-files
fi
if command -v sartoria-steam >/dev/null 2>&1; then
  bind g spawn sartoria-steam
fi

bind h focus left
bind j focus down
bind k focus up
bind l focus right
# Super+K opens the cheatsheet, same chord as Omarchy. Alt+K stays focus up.
hc keybind Mod4-k spawn sartoria-keys
bind Shift-h shift left
bind Shift-j shift down
bind Shift-k shift up
bind Shift-l shift right

bind o split right 0.5
bind u split bottom 0.5
bind s floating toggle
bind f fullscreen toggle
bind Shift-s pseudotile toggle
bind r remove
bind Tab cycle_all +1
bind Shift-Tab cycle_all -1

tag_names=( {1..9} )
tag_keys=( {1..9} )
hc rename default "${tag_names[0]}" || true
for i in "${!tag_names[@]}"; do
  hc add "${tag_names[$i]}" || true
  key="${tag_keys[$i]}"
  bind "$key" use_index "$i"
  bind "Shift-$key" move_index "$i"
done

hc mousebind Mod4-Button1 move
hc mousebind Mod4-Button3 resize
hc mousebind Mod4-Button2 zoom

# Hardware volume keys. Unmodified so the laptop multimedia keys work.
hc keybind XF86AudioRaiseVolume spawn wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
hc keybind XF86AudioLowerVolume spawn wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-
hc keybind XF86AudioMute spawn wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
hc keybind XF86AudioMicMute spawn wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# Hardware brightness keys. 5% of the panel; sartoria-brightness keeps it on.
hc keybind XF86MonBrightnessUp spawn sartoria-brightness up
hc keybind XF86MonBrightnessDown spawn sartoria-brightness down

# Super+p grabs a region. Super+Shift+p grabs the whole screen.
# This laptop and the external keyboards have no Print key.
if command -v sartoria-shot >/dev/null 2>&1; then
  bind p spawn sartoria-shot region
  bind Shift-p spawn sartoria-shot full
fi

hc rule focus=on
hc rule windowtype~'_NET_WM_WINDOW_TYPE_(DIALOG|UTILITY|SPLASH)' floating=on
hc rule windowtype='_NET_WM_WINDOW_TYPE_DIALOG' focus=on
hc rule windowtype~'_NET_WM_WINDOW_TYPE_(NOTIFICATION|DOCK|DESKTOP)' manage=off
hc rule class=Alacritty focus=on
hc rule class~'^[Bb]rave-origin$' focus=on
hc rule class=Rofi manage=off
hc rule class=dunst manage=off
# Polybar network module: centered NetworkManager TUI.
hc rule label=sartoria-nmtui class=sartoria-nmtui floating=on floatplacement=center focus=on
# Super+K keybind cheatsheet.
hc rule label=sartoria-keys class=sartoria-keys floating=on floatplacement=center focus=on
# LibreOffice: gtk3 VCL + the DIALOG/UTILITY/SPLASH rule above. Do not
# add class=Soffice or class=libreoffice — the document first-maps with
# those classes and would stay floating after it becomes libreoffice-writer.
# Steam dialogs share a class with the library. Match titles only.
if command -v sartoria-steam >/dev/null 2>&1; then
  steam_class='^[Ss]team(webhelper)?$'
  for title in 'Friends List' 'Friends' 'Steam Dialog'; do
    hc rule class~"$steam_class" title="$title" floating=on focus=on
  done
  hc rule class~"$steam_class" title~'[Ss]ettings' floating=on focus=on
  hc rule class~"$steam_class" title~' - Chat$' floating=on focus=on
  hc rule class~"$steam_class" title~'(Properties|Progress)' floating=on focus=on
fi

hc unlock

# PipeWire is a user session on sysvinit (no systemd --user).
if command -v pipewire >/dev/null 2>&1; then
  pgrep -u "$USER" -x pipewire >/dev/null || pipewire &
  pgrep -u "$USER" -x pipewire-pulse >/dev/null || pipewire-pulse &
  pgrep -u "$USER" -x wireplumber >/dev/null || wireplumber &
fi

pkill -u "$USER" -x polybar >/dev/null 2>&1 || true
if command -v polybar >/dev/null 2>&1; then
  sleep 0.2
  polybar sartoria >/dev/null 2>&1 &
fi
if command -v picom >/dev/null 2>&1; then
  pkill -u "$USER" -x picom >/dev/null 2>&1 || true
  picom -b >/dev/null 2>&1 || picom --daemon >/dev/null 2>&1 || true
fi
if command -v dunst >/dev/null 2>&1; then
  pkill -u "$USER" -x dunst >/dev/null 2>&1 || true
  dunst >/dev/null 2>&1 &
fi

# First login (empty tag): open a terminal so a Super-stealing host still
# leaves a usable window. Skip on reload when clients already exist.
if ! herbstclient compare tags.focus.client_count gt 0 2>/dev/null; then
  hc spawn "$TERMINAL"
fi
