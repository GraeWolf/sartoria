#_preseed_V1
# Sartoria Phase A lab — Devuan 6 Excalibur.
# Injected as /preseed.cfg in the debian-installer initrd.
# Not the product TUI installer.

d-i debian-installer/locale string en_US.UTF-8
d-i debian-installer/language string en
d-i debian-installer/country string US
d-i localechooser/supported-locales multiselect en_US.UTF-8
d-i keyboard-configuration/xkb-keymap select us
d-i keymap select us

d-i hw-detect/load_firmware boolean true
d-i netcfg/choose_interface select auto
d-i netcfg/use_autoconfig boolean true
d-i netcfg/get_hostname string sartoria-lab
d-i netcfg/hostname string sartoria-lab
d-i netcfg/get_domain string local
d-i netcfg/wireless_wep string

d-i mirror/country string manual
d-i mirror/protocol string http
d-i mirror/http/hostname string deb.devuan.org
d-i mirror/http/directory string /merged
d-i mirror/http/proxy string
d-i mirror/suite string excalibur
d-i mirror/udeb/suite string excalibur

d-i passwd/root-login boolean false
d-i passwd/make-user boolean true
d-i passwd/user-fullname string Sartoria Lab
d-i passwd/username string sartoria
d-i passwd/user-password password sartoria
d-i passwd/user-password-again password sartoria
d-i user-setup/allow-password-weak boolean true
d-i user-setup/encrypt-home boolean false

d-i clock-setup/utc boolean true
d-i time/zone string UTC
d-i clock-setup/ntp boolean true

d-i partman/early_command string debconf-set partman-auto/disk "$(list-devices disk | head -n1)"
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-efi/non_efi_system boolean true

d-i base-installer/kernel/image string linux-image-amd64
d-i base-installer/install-recommends boolean true

d-i apt-setup/use_mirror boolean true
d-i apt-setup/non-free boolean true
d-i apt-setup/contrib boolean true
d-i apt-setup/non-free-firmware boolean true
d-i apt-setup/disable-cdrom-entries boolean true
d-i apt-setup/enable-source-repositories boolean false
d-i apt-setup/services-select multiselect security, updates, backports

choose-init choose-init/select_init select sysvinit
d-i choose-init/select_init select sysvinit

tasksel tasksel/first multiselect standard, ssh-server
d-i pkgsel/include string openssh-server sudo ca-certificates curl gnupg
d-i pkgsel/upgrade select full-upgrade
d-i pkgsel/update-policy select none
popularity-contest popularity-contest/participate boolean false

d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean false
d-i grub-installer/bootdev string default

d-i finish-install/reboot_in_progress note

# Files copied into the installer initrd (see scripts/lab-install.sh):
#   /sartoria-authorized_keys
# Avoid in-target + nested quotes; a failed late_command drops d-i to the main menu.
d-i preseed/late_command string \
  mkdir -p /target/home/sartoria/.ssh ; \
  cp /sartoria-authorized_keys /target/home/sartoria/.ssh/authorized_keys ; \
  chroot /target chown -R sartoria:sartoria /home/sartoria/.ssh ; \
  chmod 700 /target/home/sartoria/.ssh ; \
  chmod 600 /target/home/sartoria/.ssh/authorized_keys ; \
  grep -q '^T0:' /target/etc/inittab || echo 'T0:23:respawn:/sbin/getty -L ttyS0 115200 vt100' >> /target/etc/inittab ; \
  echo 'sartoria ALL=(ALL) ALL' > /target/etc/sudoers.d/010-sartoria ; \
  chmod 440 /target/etc/sudoers.d/010-sartoria ; \
  sed -i 's/^deb cdrom:/# deb cdrom:/' /target/etc/apt/sources.list
