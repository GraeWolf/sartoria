#!/bin/sh
set -e
if [ -f /var/lib/sartoria/policy-rc.d-owned ]; then
  rm -f /usr/sbin/policy-rc.d /var/lib/sartoria/policy-rc.d-owned
fi
if [ "$1" = remove ] || [ "$1" = purge ]; then
  if command -v update-rc.d >/dev/null 2>&1 && [ -x /etc/init.d/nvidia-persistenced ]; then
    update-rc.d nvidia-persistenced enable >/dev/null 2>&1 || true
  fi
fi
exit 0
