#!/bin/sh
set -e
if [ "$1" = configure ]; then
  if [ -x /usr/lib/sartoria/seed-user-config ]; then
    /usr/lib/sartoria/seed-user-config --system || true
  fi
  if [ -x /etc/init.d/network-manager ]; then
    update-rc.d network-manager defaults >/dev/null 2>&1 || true
  fi
  if [ -f /etc/apt/sources.list ]; then
    sed -i 's/^deb cdrom:/# deb cdrom:/' /etc/apt/sources.list || true
  fi
  if command -v fc-cache >/dev/null 2>&1; then
    fc-cache -f /usr/share/fonts/truetype/sartoria >/dev/null 2>&1 || true
  fi
  # Debian ships physlock setuid root. physlock -L then turns VT
  # switching back on with no password. Drop the bit. sartoria-lock
  # is the only passwordless root path, and it cannot pass -L.
  if [ -e /usr/bin/physlock ] && command -v dpkg-statoverride >/dev/null 2>&1; then
    if ! dpkg-statoverride --list /usr/bin/physlock >/dev/null 2>&1; then
      dpkg-statoverride --update --add root root 0755 /usr/bin/physlock || true
    fi
  fi
  echo "sartoria-desktop: a sharp panel gets Xft.dpi 144 on the next startx." >&2
  echo "sartoria-desktop: console lock is Super+Shift+Esc (idle default 5 min, /etc/sartoria/lock.conf)." >&2
fi
exit 0
